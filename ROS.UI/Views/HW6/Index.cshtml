    function funInsertShipment() {
        if ($("#frmShipment").valid()) {
            var formData = $("#frmShipment").serialize();

            $.ajax({
                url: "@Url.Action("InsertShipment", "HW6")", // Your controller and action
                type: "POST",
                headers: { "RequestVerificationToken": $('#frmShipment input[name="__RequestVerificationToken"]').val() },
                data: formData,
                success: function (response) {
                    if (response.result === 'Success') {
                        toastr.success(response.message);  // Show success message
                    } else if (response.result === 'Warning') {
                        toastr.warning(response.message);    // Show error message
                    } else {
                        toastr.error(response.message);    // Show error message
                    }
                },
                error: function (request, status, error) {
                    toastr.error("An error occurred: " + request.responseText);  // Show error on failure
                }
            });
        }
    }

    function funInsertShipment2() {
        if ($("#frmShipment2").valid()) {
            var formData = $("#frmShipment2").serialize();

            $.ajax({
                url: "@Url.Action("InsertShipment", "HW6")", // Your controller and action
                type: "POST",
