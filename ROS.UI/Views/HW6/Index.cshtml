                    }
                },
                error: function (request, status, error) {
                    toastr.error("An error occurred: " + request.responseText);  // Show error on failure
                }
            });
        }
    }

    function funIncreaseSupplierStatus() {
        $.ajax({
            url: "@Url.Action("IncreaseSupplierStatus", "HW6")", // Your controller and action
            type: "POST",
            success: function (response) {
                if (response.result === 'OK') {
                    toastr.success(response.message);  // Show success message
                } else {
                    toastr.error(response.message);    // Show error message
                }
            },
            error: function (request, status, error) {
                toastr.error("An error occurred: " + request.responseText);  // Show error on failure
            }
        });
    }




    function fetchSupplierData() {
        $.ajax({
            url: "@Url.Action("GetAllSuppliers", "HW6")", // Adjust to your controller and action
            type: "GET",
            success: function (suppliers) {
                if (suppliers && suppliers.length > 0) {
                    let table = '<table class="table table-bordered"><thead><tr><th>Sno</th><th>Sname</th><th>Status</th><th>City</th></tr></thead><tbody>';
                    suppliers.forEach(supplier => {
                        table += `<tr><td>${supplier.sno}</td><td>${supplier.sname}</td><td>${supplier.status}</td><td>${supplier.city}</td></tr>`;
                    });
                    table += '</tbody></table>';
                    $('#supplierTable').html(table);
                    toastr.success('Data retrieved successfully');
                } else {
                    $('#supplierTable').html('<p>No suppliers found.</p>');
                    toastr.warning('No suppliers found');
                }
            },
            error: function () {
                $('#supplierTable').html('<p>An error occurred while fetching supplier data.</p>');
                toastr.error("An error occurred while fetching supplier data.");
            }
        });
    }

    function fetchSuppliersByPart() {
        let partNumber = $('#partNumberInput').val().trim();

        if (!partNumber) {
            toastr.warning("Please enter a part number.");
            return;
        }

        $.ajax({
            url: "@Url.Action("GetSuppliersByPart", "HW6")", // Adjust to your controller and action
            type: "GET",
            data: { partNumber: partNumber },
            success: function (suppliers) {
                if (suppliers && suppliers.length > 0) {
                    let table = '<table class="table table-bordered"><thead><tr><th>Sno</th><th>Sname</th><th>Status</th><th>City</th></tr></thead><tbody>';
                    suppliers.forEach(supplier => {
                        table += `<tr><td>${supplier.sno}</td><td>${supplier.sname}</td><td>${supplier.status}</td><td>${supplier.city}</td></tr>`;
                    });
                    table += '</tbody></table>';
                    $('#supplierTable1').html(table);
                    toastr.success('Data retrieved successfully');
                } else {
                    $('#supplierTable1').html('<p>No suppliers found for the specified part number.</p>');
                    toastr.warning('No suppliers found for the specified part number.');
                }
            },
            error: function () {
                $('#supplierTable1').html('<p>An error occurred while fetching supplier data.</p>');
                toastr.error("An error occurred while fetching data.");
            }
        });
    }
</script>
