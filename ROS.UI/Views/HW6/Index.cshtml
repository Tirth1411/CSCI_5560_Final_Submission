    <div class="card-header">
        <h3 class="card-title">
            5) Enter part number and display suppliers who shipped that part
        </h3>
    </div>

    <div class="card-body">
        <div class="input-card">
            <label>Enter Part Number:</label>
            <input type="text" id="partNumberInput" class="form-control" placeholder="Enter Part No">
        </div>

        <div class="text-center mt-3">
            <button type="button" class="btn btn-primary" onclick="fetchSuppliersByPart()">Search</button>
        </div>

        <div id="supplierTable1" class="mt-4"></div>
    </div>
</div>






