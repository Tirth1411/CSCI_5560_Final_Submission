@model ROS.Model.Shipment;

@await Html.PartialAsync("_ValidationScriptsPartial")

<style>
    .section-card {
        border-radius: 10px !important;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        border: none;
        margin-bottom: 40px;
    }

        .section-card .card-header {
            background: linear-gradient(90deg, #007bff, #00a8ff);
            color: white;
            padding: 18px;
            border-radius: 10px 10px 0 0 !important;
        }

        .section-card .card-title {
            font-weight: 600;
            font-size: 18px;
        }

    label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 6px;
        height: 42px;
    }

    .btn-primary {
        padding: 10px 28px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 15px;
    }

    .table thead th {
        background: #007bff;
        color: white;
        border-bottom: none;
        font-weight: bold;
    }

    #supplierTable table,
    #supplierTable1 table {
        margin-top: 20px;
    }

    .input-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 10px;
        border: 1px solid #e0e0e0;
    }
</style>


<!-- ======================================== -->
<!-- 1) Insert Shipment 1 -->
<!-- ======================================== -->
<div class="card section-card">
    <div class="card-header">
        <h3 class="card-title">1) Insert a new tuple ('s2', 'p3', 200, 0.006)</h3>
    </div>

    <div class="card-body">
        <form id="frmShipment">
            <div class="row">

                <div class="col-md-6">
                    <div class="input-card mb-3">
                        <label>Sno<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Sno" asp-for="Sno" />
                        <span asp-validation-for="Sno" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-card mb-3">
                        <label>Pno<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Pno" asp-for="Pno" />
                        <span asp-validation-for="Pno" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-card mb-3">
                        <label>Qty<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Qty" asp-for="Qty" />
                        <span asp-validation-for="Qty" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-card mb-3">
                        <label>Price<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Price" asp-for="Price" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="text-center mt-3">
                <button type="button" class="btn btn-primary" onclick="funInsertShipment()">Submit</button>
            </div>
        </form>
    </div>
</div>

